// Create a class named 'Student'
class Student {
    // Member variables
    String name;
    int roll_no;
    String phone_no;
    String address;
}

public class Main {
    public static void main(String[] args) {
        
        // --- Part A ---
        // Create an object of the class Student for John
        Student johnObjA = new Student();
        
        // Assign the value of roll_no as '2' and that of name as "John"
        johnObjA.roll_no = 2;
        johnObjA.name = "John";

        
        // --- Part B ---
        // Create two objects of class 'Student' for Sam and John
        Student sam = new Student();
        Student john = new Student();
        
        // Assign values for Sam
        sam.name = "Sam";
        sam.roll_no = 1;
        sam.phone_no = "123-456-7890";
        sam.address = "123 Maple Street";
        
        // Assign values for John
        john.name = "John";
        john.roll_no = 2;
        john.phone_no = "987-654-3210";
        john.address = "456 Oak Avenue";
        
        // Print the details for Sam
        System.out.println("Student Details:");
        System.out.println("Name: " + sam.name);
        System.out.println("Roll Number: " + sam.roll_no);
        System.out.println("Phone Number: " + sam.phone_no);
        System.out.println("Address: " + sam.address);
        System.out.println(); // Blank line for spacing
        
        // Print the details for John
        System.out.println("Name: " + john.name);
        System.out.println("Roll Number: " + john.roll_no);
        System.out.println("Phone Number: " + john.phone_no);
        System.out.println("Address: " + john.address);
    }
}
